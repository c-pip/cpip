# ==========================================
# SwarmDroid Environment Configuration
# ==========================================

# Server Settings
SWARMDROID_HOST=0.0.0.0
SWARMDROID_PORT=8000
SWARMDROID_ENV=development
SWARMDROID_LOG_LEVEL=INFO

# Swarm Concurrency Limits
MAX_CONCURRENT_TASKS=6
MAX_AGENT_DEPTH=4
TASK_TIMEOUT_SECONDS=60.0
MAX_TASK_RETRIES=2

# Default AI Provider ("gemini", "openai", "anthropic", "ollama", "openrouter", "custom")
DEFAULT_AI_PROVIDER=gemini

# AI Provider API Keys (leave empty if configuring via Android app)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local / Self-Hosted Endpoints
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_BASE_URL=http://localhost:8080/v1
CUSTOM_API_KEY=

# Persistent Storage
MEMORY_DB_PATH=swarmdroid_memory.db
