!app-debug.apk
!website/assets/*.apk
*.ap_
*.aab

# Keystore files
*.jks
*.keystore

# --- IDE & Editors ---
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Secrets & Environment Variables ---
.env
.env.local
*.pem
*.key
